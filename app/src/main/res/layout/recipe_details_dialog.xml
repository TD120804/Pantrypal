<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/dialogRecipeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recipe Name"
            android:textColor="#3F4938"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dialogRecipeMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="20 min  •  Easy"
            android:textColor="#817B72"
            android:textSize="14sp" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Ingredients You Have"
            android:textColor="#49683A"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dialogHave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:textColor="#5D684F"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Missing Ingredients"
            android:textColor="#9A8065"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dialogMissing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:textColor="#817B72"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="How to Cook"
            android:textColor="#49683A"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dialogSteps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:textColor="#5D5A53"
            android:textSize="14sp"
            android:lineSpacingExtra="5dp" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Waste-Saving Tip"
            android:textColor="#49683A"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dialogWasteTip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:textColor="#5D5A53"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Nutrition"
            android:textColor="#49683A"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dialogNutrition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:textColor="#5D5A53"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>

</ScrollView>
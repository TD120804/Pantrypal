<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="#FFFDF9"
    app:cardCornerRadius="24dp"
    app:cardElevation="2dp"
    app:strokeColor="#EEE8DE"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Recipe title + favorite -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/textRecipeName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Creamy Tomato Pasta"
                android:textColor="#19351F"
                android:textSize="18sp"
                android:layout_marginEnd="44dp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/buttonDeleteRecipe"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Delete recipe"
                android:padding="9dp"
                android:src="@drawable/ic_delete_recipe" />

        </RelativeLayout>

        <!-- Time + difficulty -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textCookTime"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_recipe_meta"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="◷ 25 min"
                android:textColor="#4A514A"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/textDifficulty"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_recipe_meta"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="♨ Easy"
                android:textColor="#4A514A"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="#EEE8DE" />

        <!-- Pantry ingredients -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Pantry ingredients"
                android:src="@drawable/ic_leaf"
                app:tint="#70984C" />

            <TextView
                android:id="@+id/textUsedIngredients"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:text="Uses 4 pantry ingredients"
                android:textColor="#315C38"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Missing ingredients -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Missing ingredients"
                android:src="@drawable/ic_grocery"
                app:tint="#D87520" />

            <TextView
                android:id="@+id/textMissingIngredients"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_weight="1"
                android:text="Needs 1 additional ingredient"
                android:textColor="#C7661C"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- View recipe -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/buttonViewRecipe"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_gravity="end"
            android:layout_marginTop="17dp"
            app:cardBackgroundColor="#70984C"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:text="View Recipe  →"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
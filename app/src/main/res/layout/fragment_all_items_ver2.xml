<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F2"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ================================================= -->
        <!--                 GREETING SECTION                  -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- PantryPal Logo -->
            <ImageView
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:src="@drawable/pantrypal_logo"
                android:scaleType="centerInside"
                android:contentDescription="PantryPal"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Good Morning, Trisha 🌿"
                    android:textColor="#6E9E4A"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtGreetingSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Your kitchen at a glance"
                    android:textColor="#222222"
                    android:textSize="24sp"
                    android:textStyle="bold"/>

            </LinearLayout>

        </LinearLayout>
        <!-- ================================================= -->
        <!--                   HERO SECTION                    -->
        <!-- ================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="220dp"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#EAF5E4">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="24dp">

                <!-- LEFT -->

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌿 Pantry Overview"
                        android:textColor="#6E9E4A"
                        android:textStyle="bold"
                        android:textSize="16sp"/>

                    <TextView
                        android:id="@+id/text_total_items"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="0"
                        android:textColor="#222222"
                        android:textStyle="bold"
                        android:textSize="56sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Items Available"
                        android:textColor="#666666"
                        android:textSize="16sp"/>

                    <TextView
                        android:id="@+id/textHeroTip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="✨ Everything looks healthy today."
                        android:textColor="#555555"
                        android:textSize="14sp"/>

                </LinearLayout>

                <!-- RIGHT -->

                <LinearLayout
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🥬🥕🍅🫑"
                        android:textSize="39sp"/>

                </LinearLayout>

            </RelativeLayout>

        </com.google.android.material.card.MaterialCardView>
        <!-- ================================================= -->
        <!--              DASHBOARD STATS SECTION              -->
        <!-- ================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:weightSum="4">


                <!-- ================= EXPIRING ================= -->

                <LinearLayout
                    android:id="@+id/cardExpiring"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="3dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#FFF0E2"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_warning"
                            android:contentDescription="Items expiring"/>
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/textExpiring"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="0"
                        android:textColor="#D66A18"
                        android:textSize="30sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Items expiring"
                        android:textColor="#222222"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:maxLines="1"/>


                </LinearLayout>


                <!-- ================= RECIPES ================= -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="3dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#EEF7E5"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_chef"
                            android:contentDescription="Recipes available"/>

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/textRecipes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="0"
                        android:textColor="#57932C"
                        android:textSize="30sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Recipes available"
                        android:textColor="#222222"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:maxLines="1"/>

                </LinearLayout>


                <!-- ================= SHOPPING ================= -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="3dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#FFF5D9"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_cart"
                            android:contentDescription="Shopping"/>

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/textBuy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="0"
                        android:textColor="#E49A16"
                        android:textSize="30sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Item to buy"
                        android:textColor="#222222"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:maxLines="1"/>

                </LinearLayout>


                <!-- ================= SAVINGS ================= -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="3dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#EAF6E5"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_savings"
                            android:contentDescription="Savings"/>

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/textSaved"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="₹0"
                        android:textColor="#57932C"
                        android:textSize="30sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Saved"
                        android:textColor="#222222"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:maxLines="1"/>

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ================================================= -->
        <!--          PANTRY HEALTH + AI PICK SECTION          -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:weightSum="10">

            <!-- ============================================== -->
            <!--              PANTRY HEALTH CARD                -->
            <!-- ============================================== -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="320dp"
                android:layout_weight="4.5"
                android:layout_marginEnd="6dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp">

                    <!-- Title -->

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="❤️ Pantry Health"
                        android:textColor="#222222"
                        android:textSize="18sp"
                        android:textStyle="bold"/>

                    <!-- ===== DON'T TOUCH THE METER ===== -->

                    <FrameLayout
                        android:layout_width="110dp"
                        android:layout_height="110dp"
                        android:layout_marginTop="16dp">

                        <com.mikhaellopez.circularprogressbar.CircularProgressBar
                            android:id="@+id/healthCircle"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:cpb_progress="92"
                            app:cpb_progressbar_color="#6E9E4A"
                            app:cpb_background_progressbar_color="#E5E5E5"
                            app:cpb_progressbar_width="6dp"
                            app:cpb_background_progressbar_width="6dp"/>

                        <TextView
                            android:id="@+id/text_health_score"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="92%"
                            android:textColor="#222222"
                            android:textSize="26sp"
                            android:textStyle="bold"/>

                    </FrameLayout>

                    <TextView
                        android:id="@+id/text_health_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Excellent"
                        android:textColor="#666666"
                        android:textSize="16sp"/>

                    <TextView
                        android:id="@+id/textHealthMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:text="Great job! Your pantry is well managed this week."
                        android:textAlignment="center"
                        android:textColor="#777777"
                        android:textSize="12sp"
                        android:maxLines="3"
                        android:ellipsize="end"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHealthDetails"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="14dp"
                        android:text="View Details →"
                        android:textAllCaps="false"
                        android:textColor="#4E8E2B"
                        app:backgroundTint="#EEF7E7"
                        app:cornerRadius="21dp"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ============================================== -->
            <!--                 AI PICK CARD                   -->
            <!-- ============================================== -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAI"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="320dp"
                android:layout_weight="5.5"
                app:cardCornerRadius="24dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- AI PICK TITLE -->

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✨ AI Pick of the Day"
                        android:textColor="#222222"
                        android:textSize="18sp"
                        android:textStyle="bold" />


                    <!-- RECIPE NAME -->

                    <TextView
                        android:id="@+id/textRecipeName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="Finding your best pantry recipe..."
                        android:textColor="#222222"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:ellipsize="end" />


                    <!-- RECIPE METADATA -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/textCookTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🕒 —"
                            android:textColor="#777777"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/textDifficulty"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:text="😊 Easy"
                            android:textColor="#777777"
                            android:textSize="10sp" />

                        <TextView
                            android:id="@+id/textServings"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:text="👥 2"
                            android:textColor="#777777"
                            android:textSize="10sp" />

                    </LinearLayout>


                    <!-- PANTRY AVAILABILITY -->

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="#F4F8EC"
                        app:strokeColor="#E1EAD4"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🌿 Made from your pantry"
                                android:textColor="#557A39"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/textIngredientAvailability"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="Ingredients available —"
                                android:textColor="#6E9E4A"
                                android:textSize="12sp" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>


                    <!-- COOK BUTTON -->

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCookNow"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="14dp"
                        android:text="Cook Now  →"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        app:backgroundTint="#6E9E4A"
                        app:cornerRadius="23dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
        <!-- ================================================= -->
        <!--                 QUICK ACTIONS                     -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="⚡ Quick Actions"
            android:textColor="#222222"
            android:textSize="20sp"
            android:textStyle="bold"/>


        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="10dp"
                android:weightSum="4">


                <!-- ================= ADD ITEM ================= -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAdd"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    app:cardCornerRadius="17dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#EEF7E7"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:gravity="center"
                            android:src="@drawable/ic_add_item"
                            android:contentDescription="Add Item"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Add Item"
                            android:textColor="#222222"
                            android:textSize="13sp"
                            android:textStyle="bold"/>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- ================= SCAN ITEM ================= -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardScan"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    app:cardCornerRadius="17dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#FFF8DF"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:gravity="center"
                            android:src="@drawable/ic_scan_item"
                            android:contentDescription="Scanner"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Scan Item"
                            android:textColor="#222222"
                            android:textSize="13sp"
                            android:textStyle="bold"/>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- ================= GROCERY ================= -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardGrocery"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="2dp"
                    app:cardCornerRadius="17dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#FFF3E8"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:gravity="center"
                            android:src="@drawable/ic_grocery"
                            android:contentDescription="Grocery"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Grocery"
                            android:textColor="#222222"
                            android:textSize="13sp"
                            android:textStyle="bold"/>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <!-- ================= RECIPES ================= -->

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardRecipes"
                    android:layout_width="0dp"
                    android:layout_height="110dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    app:cardCornerRadius="17dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#F5EEFF"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:gravity="center"
                            android:src="@drawable/ic_recipe"
                            android:contentDescription="Recipes"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Recipes"
                            android:textColor="#222222"
                            android:textSize="13sp"
                            android:textStyle="bold"/>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    <!-- ================================================= -->
    <!--              WEEKLY COMEBACK                     -->
    <!-- ================================================= -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardWeeklyComeback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="#EAF5E4"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="20dp">

            <!-- LEFT CONTENT -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌱 Weekly Comeback"
                    android:textColor="#557A39"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"

<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F2"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ================================================= -->
        <!--                 GREETING SECTION                  -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/txtGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Good Morning 👋"
            android:textColor="#6E9E4A"
            android:textStyle="bold"
            android:textSize="16sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Your Pantry"
            android:textColor="#222222"
            android:textStyle="bold"
            android:textSize="32sp"/>

        <!-- ================================================= -->
        <!--                   HERO SECTION                    -->
        <!-- ================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#EAF5E4">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="24dp">

                <!-- LEFT -->

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌿 Pantry Overview"
                        android:textColor="#6E9E4A"
                        android:textStyle="bold"
                        android:textSize="16sp"/>

                    <TextView
                        android:id="@+id/text_total_items"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="0"
                        android:textColor="#222222"
                        android:textStyle="bold"
                        android:textSize="56sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Items Available"
                        android:textColor="#666666"
                        android:textSize="16sp"/>

                    <TextView
                        android:id="@+id/textHeroTip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="✨ Everything looks healthy today."
                        android:textColor="#555555"
                        android:textSize="14sp"/>

                </LinearLayout>

                <!-- RIGHT -->

                <LinearLayout
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="#DDF0D1"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🥬🥕🍅"
                        android:textSize="40sp"/>

                </LinearLayout>

            </RelativeLayout>

        </com.google.android.material.card.MaterialCardView>
        <!-- ================================================= -->
        <!--              DASHBOARD STATS SECTION              -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:weightSum="4">

            <!-- Expiring -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="#FFF4E5"
                    android:gravity="center"
                    android:text="⚠️"
                    android:textSize="22sp"/>

                <TextView
                    android:id="@+id/textExpiring"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="0"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Expiring"
                    android:textColor="#777777"
                    android:textSize="12sp"/>

            </LinearLayout>

            <!-- Recipes -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="#E9F8EA"
                    android:gravity="center"
                    android:text="🍳"
                    android:textSize="22sp"/>

                <TextView
                    android:id="@+id/textRecipes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="0"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recipes"
                    android:textColor="#777777"
                    android:textSize="12sp"/>

            </LinearLayout>

            <!-- Shopping -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="#FFF7D6"
                    android:gravity="center"
                    android:text="🛒"
                    android:textSize="22sp"/>

                <TextView
                    android:id="@+id/textBuy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="0"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Shopping"
                    android:textColor="#777777"
                    android:textSize="12sp"/>

            </LinearLayout>

            <!-- Saved -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="#E7F6EF"
                    android:gravity="center"
                    android:text="💰"
                    android:textSize="22sp"/>

                <TextView
                    android:id="@+id/textSaved"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="₹0"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Saved"
                    android:textColor="#777777"
                    android:textSize="12sp"/>

            </LinearLayout>
        </LinearLayout>
        <!-- ================================================= -->
        <!--          PANTRY HEALTH + AI PICK SECTION          -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:weightSum="10">

            <!-- ============================================== -->
            <!--              PANTRY HEALTH CARD                -->
            <!-- ============================================== -->

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="345dp"
                android:layout_weight="4.5"
                android:layout_marginEnd="6dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp">

                    <!-- Title -->

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="❤️ Pantry Health"
                        android:textColor="#222222"
                        android:textSize="18sp"
                        android:textStyle="bold"/>

                    <!-- ===== DON'T TOUCH THE METER ===== -->

                    <FrameLayout
                        android:layout_width="110dp"
                        android:layout_height="110dp"
                        android:layout_marginTop="16dp">

                        <com.mikhaellopez.circularprogressbar.CircularProgressBar
                            android:id="@+id/healthCircle"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:cpb_progress="92"
                            app:cpb_progressbar_color="#6E9E4A"
                            app:cpb_background_progressbar_color="#E5E5E5"
                            app:cpb_progressbar_width="6dp"
                            app:cpb_background_progressbar_width="6dp"/>

                        <TextView
                            android:id="@+id/text_health_score"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="92%"
                            android:textColor="#222222"
                            android:textSize="26sp"
                            android:textStyle="bold"/>

                    </FrameLayout>

                    <TextView
                        android:id="@+id/text_health_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Excellent"
                        android:textColor="#666666"
                        android:textSize="16sp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center"
                        android:text="Great job! Your pantry is well managed this week."
                        android:textAlignment="center"
                        android:textColor="#777777"
                        android:textSize="12sp"
                        android:maxLines="3"
                        android:ellipsize="end"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHealthDetails"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="14dp"
                        android:text="View Details →"
                        android:textAllCaps="false"
                        android:textColor="#4E8E2B"
                        app:backgroundTint="#EEF7E7"
                        app:cornerRadius="21dp"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ============================================== -->
            <!--                 AI PICK CARD                   -->
            <!-- ============================================== -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAI"
                android:layout_width="0dp"
                android:layout_height="345dp"
                android:layout_weight="5.5"
                app:cardCornerRadius="24dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✨ AI Pick of the Day"
                        android:textColor="#222222"
                        android:textStyle="bold"
                        android:textSize="18sp"/>

                    <TextView
                        android:id="@+id/textRecipeName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Creamy Mushroom Pasta"
                        android:textColor="#222222"
                        android:textStyle="bold"
                        android:textSize="17sp"/>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/textCookTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🕒 18 min"
                            android:textColor="#777777"
                            android:textSize="12sp"/>

                        <TextView
                            android:id="@+id/textDifficulty"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="😊 Easy"
                            android:textColor="#777777"
                            android:textSize="12sp"/>

                        <TextView
                            android:id="@+id/textServings"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="👥 2"
                            android:textColor="#777777"
                            android:textSize="12sp"/>

                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="125dp"
                        android:layout_marginTop="14dp"
                        android:background="#FFF3DD">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="🍝"
                            android:textSize="54sp"/>

                    </FrameLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCookNow"
                        android:layout_width="match_parent"
                        android:layout_height="35dp"
                        android:layout_marginTop="5dp"
                        android:text="Cook Now →"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        app:backgroundTint="#6E9E4A"
                        app:cornerRadius="23dp"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
        <!-- ================================================= -->
        <!--                 QUICK ACTIONS                     -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="⚡ Quick Actions"
            android:textStyle="bold"
            android:textColor="#222222"
            android:textSize="20sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:weightSum="4">

            <!-- Add Item -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAdd"
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#EEF7E7">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:text="➕"
                        android:textSize="34sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="Add Item"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:layout_marginTop="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="Manually"
                        android:textColor="#777777"
                        android:textSize="12sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Scan -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardScan"
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFF8DF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:text="📷"
                        android:textSize="32sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="Scan Item"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:layout_marginTop="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="Barcode"
                        android:textColor="#777777"
                        android:textSize="12sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Grocery -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGrocery"
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="3dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFF3E8">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:text="🛒"
                        android:textSize="32sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="Grocery"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:layout_marginTop="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="View List"
                        android:textColor="#777777"
                        android:textSize="12sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Recipes -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardRecipes"
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#F5EEFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:text="👨‍🍳"
                        android:textSize="32sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="Recipes"
                        android:textStyle="bold"
                        android:textSize="15sp"
                        android:layout_marginTop="10dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="AI Powered"
                        android:textColor="#777777"
                        android:textSize="12sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
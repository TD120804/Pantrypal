<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="14dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp"
    android:background="@drawable/bg_category_sheet">

    <!-- Handle -->
    <View
        android:layout_width="42dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_category_handle" />

    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Choose a category"
        android:textColor="#304C2B"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Where does this belong in your pantry?"
        android:textColor="#8A806F"
        android:textSize="12sp" />

    <!-- Vegetables -->
    <LinearLayout
        android:id="@+id/categoryVegetables"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_category_item"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_category_vegetables"
            android:contentDescription="Vegetables" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Vegetables"
            android:textColor="#405D34"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/checkVegetables"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:visibility="gone"
            android:src="@drawable/ic_category_check"
            android:contentDescription="Selected" />

    </LinearLayout>

    <!-- Fruits -->
    <LinearLayout
        android:id="@+id/categoryFruits"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_category_item"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_category_fruits"
            android:contentDescription="Fruits" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Fruits"
            android:textColor="#405D34"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/checkFruits"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:visibility="gone"
            android:src="@drawable/ic_category_check"
            android:contentDescription="Selected" />

    </LinearLayout>

    <!-- Dairy -->
    <LinearLayout
        android:id="@+id/categoryDairy"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_category_item"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_category_dairy"
            android:contentDescription="Dairy" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Dairy"
            android:textColor="#405D34"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/checkDairy"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:visibility="gone"
            android:src="@drawable/ic_category_check"
            android:contentDescription="Selected" />

    </LinearLayout>

    <!-- Grains -->
    <LinearLayout
        android:id="@+id/categoryGrains"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_category_item"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_category_grains"
            android:contentDescription="Grains" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Grains"
            android:textColor="#405D34"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/checkGrains"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:visibility="gone"
            android:src="@drawable/ic_category_check"
            android:contentDescription="Selected" />

    </LinearLayout>

    <!-- Proteins -->
    <LinearLayout
        android:id="@+id/categoryProteins"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_category_item"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_category_proteins"
            android:contentDescription="Proteins" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Proteins"
            android:textColor="#405D34"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/checkProteins"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:visibility="gone"
            android:src="@drawable/ic_category_check"
            android:contentDescription="Selected" />

    </LinearLayout>

    <!-- Condiments -->
    <LinearLayout
        android:id="@+id/categoryCondiments"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_category_item"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_category_condiments"
            android:contentDescription="Condiments" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Condiments"
            android:textColor="#405D34"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/checkCondiments"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:visibility="gone"
            android:src="@drawable/ic_category_check"
            android:contentDescription="Selected" />

    </LinearLayout>

    <!-- Snacks -->
    <LinearLayout
        android:id="@+id/categorySnacks"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_category_item"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_category_snacks"
            android:contentDescription="Snacks" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Snacks"
            android:textColor="#405D34"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/checkSnacks"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:visibility="gone"
            android:src="@drawable/ic_category_check"
            android:contentDescription="Selected" />

    </LinearLayout>

    <!-- Other -->
    <LinearLayout
        android:id="@+id/categoryOther"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_category_item"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_category_other"
            android:contentDescription="Other" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Other"
            android:textColor="#405D34"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/checkOther"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:visibility="gone"
            android:src="@drawable/ic_category_check"
            android:contentDescription="Selected" />

    </LinearLayout>

</LinearLayout>